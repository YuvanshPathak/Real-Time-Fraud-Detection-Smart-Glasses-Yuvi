#ifndef CONFIG_H
#define CONFIG_H

// Template for include/config.h. Copy it to config.h (gitignored) and fill in
// real values; never commit config.h. Re-check the IP each session, since
// DHCP addresses drift.

// ─── Wi-Fi Credentials ──────────────────────────────────────────────────────
#define WIFI_SSID      "your-hotspot-ssid"
#define WIFI_PASSWORD  "your-hotspot-password"

// ─── Backend Base URL ───────────────────────────────────────────────────────
// No trailing slash. Backend must be started with --host 0.0.0.0.
#define BACKEND_URL    "http://192.168.x.x:8000"  // laptop LAN IP from ipconfig

// ─── Audio ───────────────────────────────────────────────────────────────────
#define SAMPLE_RATE        16000
#define RECORD_SECONDS     5

// ─── PDM Microphone Pins (XIAO ESP32-S3 Sense) ───────────────────────────────
#define MIC_DATA_PIN       GPIO_NUM_41
#define MIC_CLK_PIN        GPIO_NUM_42

// ─── Alert LED (onboard LED on XIAO ESP32-S3) ────────────────────────────────
#define ALERT_LED_PIN      21

// ─── Timing ───────────────────────────────────────────────────────────────────
#define LOOP_INTERVAL_MS   10000

#endif
